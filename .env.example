# MiniRoutingAI — environment template
# Salin ke .env dan isi nilai sebenarnya. Jangan commit .env.

PORT=3000

# Provider API keys (hanya nama variabel yang disimpan di repo)
# Catatan: nilai *_BASE_URL di .env adalah dokumentasi; baseURL otoritatif ada di config/providers.json.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_API_KEY=

JUAN_API_KEY=
JUAN_BASE_URL=https://router.juan.web.id/v1

# Headroom (Phase 6) — proxy compression service
# Jalankan: headroom proxy --port 8787  (headroom-ai 0.37.0, pipx)
# Mode: token (maksimalkan penghematan; benchmark ±27% hemat, ~10ms setelah warm).
# Proxy launch args ada di scripts/manage.ps1 (Start-Headroom).
# Jika HEADROOM_URL tidak set, Headroom skip (fail-open, balanced route headroom:true tetap skip missing_url).
# Timeout 4000ms (sinkron dengan config/optimization.json), minimumTokens 6000, healthProbeMs 500ms, cacheTtl 10s, circuit breaker 2 fails → cooldown 30s, payload cap 1.5MB, early-skip >180k tokens.
# Jika timeout masih muncul, cek: powershell -File scripts/manage.ps1 status  |  Get-Content logs/headroom.log -Tail 50  |  curl http://localhost:8787/health
# Jika log berisi SystemError pydantic-core incompatible (pydantic 2.13.5 butuh pydantic-core==2.46.5):
#   C:\Users\kings\AppData\Local\Programs\Python\Python314\python.exe -m pip install --force-reinstall "pydantic-core==2.46.5"
# Alternatif isolasi: pipx reinstall headroom-ai. Jangan upgrade pydantic-core manual tanpa samakan pydantic.
# Debug: curl http://localhost:3000/debug/headroom | curl http://localhost:3000/metrics (headroom.fails/timeouts/cooldowns)
HEADROOM_URL=http://localhost:8787

# Logging
LOG_LEVEL=info
