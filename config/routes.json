{
  "routes": {
    "balanced": {
      "strategy": "weighted-round-robin",
      "primary": { "provider": "ollama-cloud", "model": "nemotron-3-ultra:cloud" },
      "fallbacks": [
        { "provider": "opencode-go", "model": "deepseek-v4-flash", "weight": 10, "tags": ["coding", "fast"] },
        { "provider": "opencode-go", "model": "deepseek-v4-flash-vision-exp", "weight": 8, "tags": ["vision", "coding"] },
        { "provider": "opencode-go", "model": "minimax-m3", "weight": 7, "tags": ["general"] },
        { "provider": "ollama-cloud", "model": "gemma4:31b", "weight": 7, "tags": ["reasoning"] },
        { "provider": "opencode", "model": "muse-spark-1.3-contributor-free", "weight": 5, "tags": ["free", "general"] },
        { "provider": "opencode", "model": "mimo-v2.5-free", "weight": 5, "tags": ["free", "general"] },
        { "provider": "opencode", "model": "nemotron-3-ultra-free", "weight": 5, "tags": ["free", "reasoning"] },
        { "provider": "openrouter", "model": "minimax/minimax-m3:free", "weight": 6, "tags": ["free", "general"] },
        { "provider": "openrouter", "model": "nvidia/nemotron-3-ultra-550b-a55b:free", "weight": 6, "tags": ["free", "reasoning"] },
        { "provider": "openrouter", "model": "deepseek/deepseek-v4-flash-0731", "weight": 8, "tags": ["coding", "free"] },
        { "provider": "openrouter", "model": "~deepseek/deepseek-v4-flash-latest", "weight": 7, "tags": ["coding", "free"] },
        { "provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b", "weight": 4, "tags": ["reasoning", "enterprise"] },
        { "provider": "juan", "model": "glm-5.3-flash", "weight": 3, "tags": ["fast", "multilingual"] },
        { "provider": "juan", "model": "minimax-m3", "weight": 3, "tags": ["general"] },
        { "provider": "juan", "model": "nemotron-3-ultra", "weight": 3, "tags": ["reasoning"] },
        { "provider": "juan", "model": "gemini-3.8-flash-high", "weight": 3, "tags": ["multilingual", "reasoning"] }
      ],
      "timeoutMs": 8000,
      "retry": { "maxRetries": 0, "backoffMs": 50 },
      "optimizers": { "rtk": true, "headroom": true, "caveman": "lite", "ponytail": "lite" },
      "healthAwareOrdering": true,
      "minHealthyCandidates": 3,
      "modelHints": ["coding", "code", "programming", "debug", "refactor"]
    }
  },
  "defaultRoute": "balanced"
}
