{
  "routes": {
    "balanced": {
      "strategy": "cache-aware-sticky",
      "warmThresholdRequests": 10,
      "sameProviderFallback": true,
      "primary": { "provider": "ollama-cloud", "model": "nemotron-3-ultra:cloud", "weight": 10, "tags": ["reasoning", "quality"] },
      "fallbacks": [
        { "provider": "ollama-cloud", "model": "gemma4:31b", "weight": 8, "tags": ["reasoning"] },
        { "provider": "opencode-go", "model": "deepseek-v4-flash", "weight": 10, "tags": ["fast", "coding"] },
        { "provider": "opencode-go", "model": "deepseek-v4-flash-vision-exp", "weight": 9, "tags": ["vision", "coding"] },
        { "provider": "opencode-go", "model": "minimax-m3", "weight": 8, "tags": ["general"] },
        { "provider": "openrouter", "model": "nvidia/nemotron-3-ultra-550b-a55b:free", "weight": 7, "tags": ["free", "reasoning"] },
        { "provider": "openrouter", "model": "minimax/minimax-m3:free", "weight": 6, "tags": ["free", "general"] },
        { "provider": "openrouter", "model": "deepseek/deepseek-v4-flash-0731", "weight": 5, "tags": ["free", "coding"] },
        { "provider": "openrouter", "model": "~deepseek/deepseek-v4-flash-latest", "weight": 4, "tags": ["free", "coding"] },
        { "provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b", "weight": 6, "tags": ["reasoning", "enterprise"] },
        { "provider": "nvidia", "model": "minimaxai/minimax-m3", "weight": 5, "tags": ["general", "enterprise"] },
        { "provider": "opencode", "model": "mimo-v2.5-free", "weight": 5, "tags": ["free", "general"] },
        { "provider": "opencode", "model": "ling-3.0-flash-fin-free", "weight": 5, "tags": ["free", "fast"] },
        { "provider": "opencode", "model": "nemotron-3.5-lightning-free", "weight": 4, "tags": ["free", "fast", "reasoning"] },
        { "provider": "opencode", "model": "nemotron-3-ultra-free", "weight": 3, "tags": ["free", "reasoning"] },
        { "provider": "juan", "model": "gemini-3.7-flash-low", "weight": 3, "tags": ["multilingual", "fast"] },
        { "provider": "juan", "model": "glm-5.3-flash", "weight": 3, "tags": ["multilingual", "fast"] },
        { "provider": "juan", "model": "minimax-m3", "weight": 3, "tags": ["general"] },
        { "provider": "juan", "model": "gemini-3.8-flash-high", "weight": 2, "tags": ["multilingual", "quality"] },
